# Copy to .env and fill in. Never commit .env.
VIAM_API_KEY=
VIAM_API_KEY_ID=
VIAM_MACHINE_ADDRESS=armfarm5-main.310sld03v2.viam.cloud

VIAM_ARM=arm
VIAM_CAMERA=cam
VIAM_GRIPPER=gripper

# Vision services on armfarm05 — color only (any shape/size in view).
#   {color}-object-detector / {color}-object-segmenter   label={color}
# Colors: green, red, orange, yellow, black
#   blue-tape-detector / blue-tape-segmenter outline the two squares.
#   The black cube is nearly gray, so pick_place_cubes.py labels it locally
#   from low saturation and brightness (VIAM_BLACK_MAX_SATURATION / VALUE).
# segment_size_px=150, min_points_in_segment=25 so small pieces still match.
VIAM_DETECTOR=red-object-detector
VIAM_SEGMENTER=red-object-segmenter
VIAM_MOTION=builtin
VIAM_DETECT_LABEL=red

# RGB-D sorting between two blue-tape enclosures (preview-only by default).
# The source is whichever enclosure contains raised depth objects; the other is
# the destination. Shapes/colors are not classified. Tune the tape HSV bounds if
# the camera's lighting makes the tape appear outside this blue range.
# VIAM_TAPE_H_MIN=90
# VIAM_TAPE_H_MAX=135
# VIAM_TAPE_S_MIN=45
# VIAM_TAPE_V_MIN=25
# VIAM_MIN_ZONE_RECTANGULARITY=0.7
# VIAM_ZONE_INSET_PX=12
# VIAM_BLACK_MAX_SATURATION=70
# VIAM_BLACK_MAX_VALUE=90
# Raise the defaults only if the preview misses real objects; these suppress depth speckle.
# VIAM_OBJECT_DEPTH_DELTA_MM=15
# VIAM_MIN_OBJECT_AREA_PX=300
# VIAM_MAX_OBJECT_HEIGHT_MM=300
# VIAM_MIN_CAMERA_DEPTH_MM=100
# VIAM_MAX_CAMERA_DEPTH_MM=2000
# VIAM_MAX_OBJECTS_PER_RUN=10
# VIAM_DROP_SLOT_GAP_PX=36
# VIAM_DROP_SLOT_INSET_PX=28
# Release TCP height above the destination table estimate (keep jaws clear of neighbors).
# VIAM_PLACE_RELEASE_HEIGHT_MM=120
# How far past the closed jaw pose to open on drop (0–850 scale; full open is 850).
# VIAM_RELEASE_OPEN_EXTRA=220
# VIAM_TABLE_PLANE_TOLERANCE_MM=55
# Teach the overview pose once, with the arm already positioned there and gripper empty:
#   VIAM_SAVE_VIEW_POSE=1 python pick_place_cubes.py
# On motion-enabled runs, the script returns to that saved pose before taking its scene image.
# It uses VIAM_VIEW_SPEED_DEGS_PER_SEC=25 unless overridden.

# On-robot generic service from pick-red-cube-module (after you deploy it).
VIAM_PICK_SERVICE=pick-red-cube

# Soft-lob catch Control Code (see catch-thrown-object-module/INLINE_SETUP.md).
# VIAM_CATCH_SERVICE=catch-thrown-object

# Self-toss + catch (throw_catch_cube.py). Preview by default.
# Soft vertical toss only — people clear of workcell; hand on e-stop.
# VIAM_THROW_CATCH_ENABLE=0
# VIAM_SAFETY_ACK=I_UNDERSTAND_THROW_CATCH_RISKS
# Optional toss heights (world mm; apex hard-capped at 220):
# VIAM_TOSS_RELEASE_Z_MM=180
# VIAM_TOSS_APEX_Z_MM=220
# VIAM_ARM_SPEED_DEGS_PER_SEC=10

# Preview is the default. Physical motion requires VIAM_PICK_ENABLE=1 AND all
# required motion settings below.
# VIAM_PICK_ENABLE=0

# Required before motion (no defaults in the script — set explicitly):
# VIAM_APPROACH_CLEARANCE_MM=100
# VIAM_LIFT_MM=100
# VIAM_APPROACH_SPEED_DEGS_PER_SEC=8
# VIAM_DESCENT_STEP_MM=25
# Grasp height: claws hang below TCP — keep both >= 50 mm (≈2 in) or jaws hit table.
VIAM_GRASP_TCP_Z_OFFSET_MM=65
VIAM_MIN_TCP_ABOVE_TABLE_MM=55
# Optional; leave 0.
# VIAM_TABLE_KEEP_OUT_MM=0
# VIAM_GRASP_OX=0
# VIAM_GRASP_OY=0
# VIAM_GRASP_OZ=-1
# VIAM_GRASP_THETA_DEG=0

# Optional tuning:
# VIAM_MIN_DETECTION_CONFIDENCE=0.5
# VIAM_VISION_TIMEOUT_SEC=30
# VIAM_MOVE_TIMEOUT_SEC=60
# VIAM_GRIPPER_SPEED=800
# VIAM_GRIPPER_TORQUE_PCT=40

# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
